{
  "manifest_version": 3,
  "name": "Auto Prompt Manager",
  "version": "1.0",
  "description": "Universal Auto Prompt Manager with Excel & Media Support",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {
    "default_popup": "index.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}